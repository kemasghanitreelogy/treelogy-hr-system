# Copy to .env.local and fill in. Values below are EXAMPLES (placeholders), not real keys.

# Supabase — leave blank to run on built-in seed data; fill in to use the live backend.
# Example:
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-only (admin tasks / seeding). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# SMTP for password-reset OTP emails (server-only). Gmail/Workspace example.
# SMTP_PASS is a Google App Password (16 chars), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Treelogy HR <you@yourdomain.com>
# Optional: pepper for hashing OTP codes. Falls back to SUPABASE_SERVICE_ROLE_KEY.
OTP_SECRET=any-long-random-string

# Web Push (VAPID). Generate real keys with:  npx web-push generate-vapid-keys --json
# Example:
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# mailto: email OR https: URL you control (not verified by push services).
VAPID_SUBJECT=mailto:you@example.com

# Google Sheet keuangan — tujuan baris "Pengajuan Pembayaran".
# Jalur Apps Script (tanpa GCP): pasang scripts/google-apps-script/payment-sheet-sync.gs
# di spreadsheet, Deploy sebagai Web app, lalu isi URL /exec di bawah.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
SHEETS_WEBHOOK_SECRET=samakan-dengan-SECRET-di-Apps-Script
# Jalur alternatif (service account) — isi ini SEBAGAI GANTI dua baris di atas:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=1cBVWKsVpFRRmQzfC6rEhhKOKo90tPDzWBc1oN0pkcqg
# GOOGLE_SHEET_TAB=Form responses 1
